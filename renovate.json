{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "github>christianpflugradt/repository-catalog:renovate-governor",
    "github>christianpflugradt/repository-catalog:renovate-content-aware",
    ":maintainLockFilesMonthly"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "!please-behave/cli",
        "!please-behave/action"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Non-major GitHub Actions updates are grouped and use a 14-day cooldown.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "github-actions",
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "!please-behave/action"
      ]
    }
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "rebaseWhen": "behind-base-branch",
  "automerge": false,
  "platformAutomerge": false
}
